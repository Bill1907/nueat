{
  "name": "nueat",
  "version": "1.0.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "bun run --filter @nueat/mobile start",
    "mobile": "bun run --filter @nueat/mobile start",
    "ios": "bun run --filter @nueat/mobile ios",
    "android": "bun run --filter @nueat/mobile android",
    "web": "bun run --filter @nueat/mobile web",
    "lint": "bun run --filter @nueat/mobile lint",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun test"
  }
}
