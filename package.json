{
  "name": "nueat",
  "version": "1.0.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "expo-constants": "57.0.10"
  },
  "scripts": {
    "start": "bun run --filter @nueat/mobile start",
    "mobile": "bun run --filter @nueat/mobile start",
    "api": "bun run --filter @nueat/api dev",
    "api:start": "bun run --filter @nueat/api start",
    "ios": "bun run --filter @nueat/mobile ios",
    "android": "bun run --filter @nueat/mobile android",
    "web": "bun run --filter @nueat/mobile web",
    "lint": "bun run --filter @nueat/mobile lint",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun test",
    "db:check": "bun run --cwd packages/database db:check",
    "db:migrate:bridge": "bun run --cwd packages/database db:migrate:bridge",
    "db:migrate:0022": "bun run --cwd packages/database db:migrate:0022",
    "db:migrate:0023": "bun run --cwd packages/database db:migrate:0023"
  }
}
