NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=debug
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require&channel_binding=require
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
RESEND_API_KEY=re_replace_me
AUTH_EMAIL_FROM=NUEAT <auth@boseong.dev>
TRUSTED_ORIGINS=nueat://,http://localhost:8081
HEALTH_DB_TIMEOUT_MS=2000
S3_ENDPOINT=https://storage.railway.app
S3_REGION=auto
S3_BUCKET=replace-with-railway-BUCKET
S3_ACCESS_KEY_ID=replace-with-railway-ACCESS_KEY_ID
S3_SECRET_ACCESS_KEY=replace-with-railway-SECRET_ACCESS_KEY
S3_URL_STYLE=virtual
IMAGE_UPLOAD_URL_TTL_SECONDS=300
IMAGE_DOWNLOAD_URL_TTL_SECONDS=120
IMAGE_MAX_BYTES=10000000
