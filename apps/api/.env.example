NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=debug
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require&channel_binding=require
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
RESEND_API_KEY=re_replace_me
AUTH_EMAIL_FROM=NUEAT <auth@boseong.dev>
TRUSTED_ORIGINS=nueat://,http://localhost:8081
HEALTH_DB_TIMEOUT_MS=2000
S3_ENDPOINT=https://storage.railway.app
S3_REGION=auto
S3_BUCKET=replace-with-railway-BUCKET
S3_ACCESS_KEY_ID=replace-with-railway-ACCESS_KEY_ID
S3_SECRET_ACCESS_KEY=replace-with-railway-SECRET_ACCESS_KEY
S3_URL_STYLE=virtual
IMAGE_UPLOAD_URL_TTL_SECONDS=300
IMAGE_DOWNLOAD_URL_TTL_SECONDS=120
IMAGE_MAX_BYTES=10000000
VECTOR_SHADOW_MODE=off
MEAL_RECOGNITION_MODE=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini-2026-03-17
MEAL_RECOGNITION_DEADLINE_MS=20000
MEAL_RECOGNITION_MAX_OUTPUT_TOKENS=2000
MEAL_RECOGNITION_MAX_ATTEMPTS=2
MEAL_RECOGNITION_DAILY_ATTEMPT_QUOTA=20
# exact_review is the default. hybrid_review always requires user review.
# hybrid_auto is production-only and requires one signed meal-stack-golden-report-v3
# receipt for the deployed V3 prompt, schema, resolver, policy, catalog, and mapping stack.
# VECTOR_SHADOW_MODE remains fail-closed unavailable until a pinned local encoder artifact is supplied.
MEAL_RECOGNITION_MAPPING_MODE=exact_review
# Emergency override may only disable or downgrade an active mapping mode.
MEAL_RECOGNITION_EMERGENCY_OVERRIDE=none
# Canonical JSON activation identity; never include photos, prompts containing user data, or predictions.
MEAL_RECOGNITION_ACTIVATION_IDENTITY_JSON=
MEAL_RECOGNITION_APPROVED_REPORT_SHA256=
MEAL_RECOGNITION_ACTIVE_REPORT_SHA256=
MEAL_RECOGNITION_APPROVED_REPORT_VERSION=
MEAL_RECOGNITION_APPROVED_REPORT_JSON=
MEAL_RECOGNITION_APPROVAL_KEY_ID=
MEAL_RECOGNITION_APPROVAL_PUBLIC_KEY=
MEAL_RECOGNITION_CATALOG_REGISTRY_VERSION=
MEAL_RECOGNITION_CATALOG_REGISTRY_SHA256=
# Client protocol required for every meal confirmation:
# meal-confirmation-safe-review-v1. maintenance_bridge keeps compatible clients
# blocked while the bridge runs; safe_review_maintenance blocks the safe-review flow.
MEAL_CONFIRMATION_CUTOVER_MODE=normal
MEAL_CONFIRMATION_MAINTENANCE_RETRY_AFTER_SECONDS=60
