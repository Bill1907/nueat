# Application access uses a direct, non-pooled Neon connection string. Do not place real values here.
DATABASE_URL=postgresql://USER:PASSWORD@DIRECT_HOST.neon.tech/DB?sslmode=require&channel_binding=require

# Guarded migration/validation target identity. Validation only accepts an approved isolated branch.
NUEAT_DATABASE_ENVIRONMENT=isolated_neon_branch
NUEAT_NEON_PROJECT_ID=project-id
NUEAT_NEON_BRANCH_ID=isolated-branch-id
NUEAT_ALLOWED_NEON_BRANCH_IDS=isolated-branch-id
NUEAT_PRODUCTION_NEON_PROJECT_ID=production-project-id
NUEAT_PRODUCTION_NEON_BRANCH_ID=production-branch-id
NEON_API_KEY=REDACTED_NEON_CONTROL_PLANE_KEY

# Production migration is rejected unless the guarded operator supplies all three values.
NUEAT_PRODUCTION_OVERRIDE_TOKEN=REDACTED_APPROVAL_TOKEN
NUEAT_PRODUCTION_OVERRIDE_ACTOR=approved-operator-id
NUEAT_PRODUCTION_CHANGE_REFERENCE=approved-change-reference
