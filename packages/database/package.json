{
  "name": "@nueat/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./catalog-normalization": "./src/catalog-normalization.ts",
    "./catalog-release": "./src/catalog-release.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "typecheck:scripts": "tsc --noEmit --project tsconfig.scripts.json",
    "db:generate": "bun run scripts/generate.ts",
    "db:migrate:bridge": "bun run scripts/migrate.ts bridge",
    "db:migrate:0022": "bun run scripts/migrate.ts 0022",
    "db:migrate:0023": "bun run scripts/migrate.ts 0023",
    "db:migrate:0024": "bun run scripts/migrate.ts 0024",
    "db:validate:recognition-reliability": "bun run scripts/validate-recognition-reliability.ts",
    "db:check": "bun run scripts/check.ts",
    "db:import:data-go-foods": "bun run scripts/import-data-go-foods.ts",
    "db:catalog:backfill": "bun run scripts/catalog-release.ts --apply --action backfill",
    "db:catalog:publish": "bun run scripts/catalog-release.ts --apply --action publish",
    "db:catalog:validate": "bun run scripts/catalog-release.ts --apply --action validate",
    "db:catalog:index": "bun run scripts/catalog-release.ts --apply --action index"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.8",
    "drizzle-orm": "^0.44.7",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "~6.0.3"
  }
}
